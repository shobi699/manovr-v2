# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron build artifacts
*.exe
*.rar
*.zip

# local database and its backups (contain personnel data)
prisma/*.db
prisma/*.db-journal
backups/
data/
export/

# tool output
graphify-out/

# agent worktrees (disposable, can be multi-GB)
.claude/worktrees/

# office temporary & binary docs
~$*
*.docx
*.pdf

# SQLite temporary WAL and lock files
prisma/*.db-shm
prisma/*.db-wal
prisma/*.db.backup-*

# Test outputs & virtual test shares
test-results/
playwright-report/
tests/virtual-network-share/
