{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DistributionManifestSchema",
  "description": "Schema for the final packaged distribution artifacts and user documentation",
  "type": "object",
  "required": [
    "manifestId",
    "productName",
    "version",
    "buildDateJalali",
    "distributionDirectory",
    "artifacts",
    "systemRequirements"
  ],
  "properties": {
    "manifestId": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "buildDateJalali": {
      "type": "string"
    },
    "distributionDirectory": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["format", "fileName", "relativePath", "sizeBytes", "verifiedExecutable"],
        "properties": {
          "format": {
            "type": "string",
            "enum": ["PORTABLE", "INSTALLER", "UNPACKED_DIR", "USER_GUIDE"]
          },
          "fileName": { "type": "string" },
          "relativePath": { "type": "string" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sizeFormatted": { "type": "string" },
          "sha256Hash": { "type": "string" },
          "verifiedExecutable": { "type": "boolean" }
        }
      }
    },
    "systemRequirements": {
      "type": "object",
      "required": ["os", "architecture", "minRam", "networkShareCompatible"]
    }
  }
}
